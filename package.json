{
  "name": "tangram",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:service": "turbo run dev --filter=@tangram/service",
    "dev:admin": "turbo run dev --filter=@tangram/admin",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"apps/*/src/**/*.{ts,vue,css,json}\" \"packages/*/src/**/*.{ts,vue,css,json}\"",
    "gen:types": "supabase gen types typescript --linked --schema public > packages/shared/src/types/supabase.ts"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "^2.5.0"
  }
}
